# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=5000
NODE_ENV=development

# ==============================================================================
# Firebase Admin SDK Credentials
# Leave empty for local mock/dev mode. Fill with your project credentials when ready.
# ==============================================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-firebase-project-id.firebaseio.com

# ==============================================================================
# Redis Cache Configuration
# Leave empty to automatically use in-memory NodeCache (15-min TTL default).
# Example: redis://localhost:6379 or rediss://default:token@redis-host:6379
# ==============================================================================
REDIS_URL=

# ==============================================================================
# Weather & Geospatial API Configurations
# ==============================================================================
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1
MARINE_BASE_URL=https://marine-api.open-meteo.com/v1

IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=
CPCB_API_KEY=

# Optional AI Key for Natural Language Persona Synthesis
AI_API_KEY=

# ==============================================================================
# MongoDB / Mongoose URI (Optional)
# ==============================================================================
MONGODB_URI=

